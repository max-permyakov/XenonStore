@page
@model CartModel
<h2>Your cart</h2>
<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Quantity</th>
            <th>Item</th>
            <th class="text-right">Price</th>
            <th class="text-right">Subtotal</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var line in Model?.Cart?.Lines ?? Enumerable.Empty<CartLine>())
        {
            <tr>
                <td class="text-center">
                    <div class="btn-group" role="group">
                        <form method="post" asp-page-handler="RemoveOne" class="d-inline">
                            <input type="hidden" name="productId" value="@line.Product.ProductID" />
                            <input type="hidden" name="returnUrl" value="@Request.Path" />
                            <button type="submit" class="btn btn-sm btn-outline-secondary">−</button>
                        </form>
                        <span class="mx-2 align-middle">@line.Quantity</span>
                        <form method="post" asp-page-handler="AddOne" class="d-inline">
                            <input type="hidden" name="productId" value="@line.Product.ProductID" />
                            <input type="hidden" name="returnUrl" value="@Request.Path" />
                            <button type="submit" class="btn btn-sm btn-outline-success">+</button>
                        </form>
                    </div>
                </td>
                <td class="text-left">@line.Product.Name</td>
                <td class="text-right">@line.Product.Price.ToString("c")</td>
                <td class="text-right">
                    @((line.Quantity * line.Product.Price).ToString("c"))
                </td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr>
            <td colspan="3" class="text-right">Total:</td>
            <td class="text-right">
                @Model?.Cart?.ComputeTotalValue().ToString("c")
            </td>
        </tr>
    </tfoot>
</table>
<div class="text-center">
    <a class="btn btn-primary" asp-action="Index" asp-controller="Home">Continue shopping</a>
    <a class="btn btn-primary" asp-action="Checkout" asp-controller="Order">
        Checkout
    </a>
</div>