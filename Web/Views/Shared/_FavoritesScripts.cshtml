@using Microsoft.AspNetCore.Antiforgery
@inject IAntiforgery Antiforgery
@{
    var antiforgeryToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;
}
<script>
    (function () {
        const token = '@antiforgeryToken';

        function updateBadge(count) {
            const badge = document.querySelector('.favorites-count-badge');
            if (!badge) return;
            badge.textContent = count;
            badge.classList.toggle('d-none', count <= 0);
        }

        function showEmptyIfNeeded() {
            const favoritesList = document.querySelector('[data-favorites-page]');
            if (!favoritesList) return;
            if (favoritesList.querySelectorAll('.col-lg-3').length === 0 && !favoritesList.querySelector('#favorites-empty')) {
                favoritesList.innerHTML = '<div class="col-12 text-center py-5" id="favorites-empty">'
                    + '<h4>В избранном пусто</h4>'
                    + '<p class="text-muted">Нажмите на сердечко на карточке товара, чтобы добавить его в избранное</p>'
                    + '</div>';
            }
        }

        document.addEventListener('click', function (e) {
            const btn = e.target.closest('.btn-fav-toggle');
            if (!btn) return;
            e.preventDefault();
            const productId = btn.dataset.productId;

            fetch('/Favorites?handler=Toggle', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token,
                    'X-CSRF-TOKEN': token,
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: new URLSearchParams({
                    productId: productId,
                    returnUrl: window.location.pathname + window.location.search
                })
            })
                .then(response => {
                    if (!response.ok) throw new Error('Network error');
                    return response.json();
                })
                .then(data => {
                    if (data.isFavorite) {
                        btn.classList.add('favorited');
                        btn.title = 'Убрать из избранного';
                    } else {
                        btn.classList.remove('favorited');
                        btn.title = 'В избранное';
                        const favoritesList = document.querySelector('[data-favorites-page]');
                        if (favoritesList) {
                            const card = btn.closest('.col-lg-3');
                            if (card) card.remove();
                            showEmptyIfNeeded();
                        }
                    }
                    updateBadge(data.count);
                })
                .catch(error => {
                    console.error('Error toggling favorite:', error);
                });
        });
    })();
</script>
