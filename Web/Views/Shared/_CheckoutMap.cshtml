@model Order
@{
    var lat = Model?.Latitude;
    var lng = Model?.Longitude;
    var latJs = (lat ?? 55.7558).ToString(System.Globalization.CultureInfo.InvariantCulture);
    var lngJs = (lng ?? 37.6173).ToString(System.Globalization.CultureInfo.InvariantCulture);
}
<input type="hidden" asp-for="Latitude" />
<input type="hidden" asp-for="Longitude" />

<div class="mb-2 position-relative">
    <input type="text" id="address-search" class="form-control"
           placeholder="Search address (city, street, house)..."
           autocomplete="off" />
    <ul id="address-results" class="list-group address-results position-absolute w-100 shadow"
        style="display:none; z-index: 2000;"></ul>
</div>

<div id="checkout-map" class="rounded border mb-2" style="height: 320px;"
     data-lat="@latJs" data-lng="@lngJs"></div>
<p class="text-muted small mb-0">
    <i class="fas fa-info-circle"></i> Click the map or drag the marker to set the delivery point.
</p>
