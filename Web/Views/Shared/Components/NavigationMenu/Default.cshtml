@using System.Security.Claims
@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var userName = User.Identity?.Name ?? "";
    var isAdmin = User.IsInRole("Admin") || User.IsInRole("Supplier");
    var avatarUrl = isAuthenticated
        ? Context.RequestServices.GetRequiredService<Microsoft.AspNetCore.Http.IHttpContextAccessor>()
            .HttpContext?.User?.FindFirst("AvatarUrl")?.Value
        : null;
}
<div class="container-fluid">
    <div class="row">
        <nav class="navbar navbar-expand-lg bg-body-secondary">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-action="Index" asp-controller="Home">
                    <i class="fas fa-bolt text-warning"></i> Xenon
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse d-flex" id="navbarNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link active btn" asp-action="Index" asp-controller="Home" asp-route-category="">
                                <i class="fas fa-home me-1"></i> Home
                            </a>
                        </li>
                    </ul>
                    <form class="d-flex mx-auto" style="max-width: 480px; flex: 1 1 auto;"
                          method="get" asp-action="Index" asp-controller="Home" role="search">
                        <input type="text" class="form-control form-control-sm me-2"
                               name="searchTerm" value="@Context.Request.Query["searchTerm"]"
                               placeholder="Поиск товаров..." />
                        <button class="btn btn-sm btn-outline-primary" type="submit" title="Поиск">
                            <i class="fas fa-search"></i>
                        </button>
                    </form>
                    @if (!string.IsNullOrEmpty(Context.Request.Query["searchTerm"]))
                    {
                        <a class="ms-2 text-decoration-none small text-nowrap" asp-action="Index" asp-controller="Home">
                            <i class="fas fa-times"></i> Сбросить
                        </a>
                    }
                </div>
                <div class="d-flex align-items-center gap-2">
                    @if (isAuthenticated)
                    {
                        <div class="dropdown">
                            <a class="btn btn-outline-dark btn-sm dropdown-toggle d-flex align-items-center gap-2"
                               href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                @if (!string.IsNullOrEmpty(avatarUrl))
                                {
                                    <img src="@avatarUrl" class="rounded-circle" width="24" height="24" alt="avatar" />
                                }
                                else
                                {
                                    <i class="fas fa-user-circle"></i>
                                }
                                <span>@userName</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" asp-controller="Profile" asp-action="Index"><i class="fas fa-user me-2"></i> Профиль</a></li>
                                @if (isAdmin)
                                {
                                    <li><a class="dropdown-item" href="/Admin"><i class="fas fa-cog me-2"></i> Админ-панель</a></li>
                                }
                                <li><hr class="dropdown-divider" /></li>
                                <li><a class="dropdown-item text-danger" asp-controller="Account" asp-action="Logout"><i class="fas fa-sign-out-alt me-2"></i> Выйти</a></li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a class="btn btn-outline-dark btn-sm" asp-controller="Account" asp-action="Login">
                            <i class="fas fa-sign-in-alt me-1"></i> Войти
                        </a>
                        <a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Register">
                            <i class="fas fa-user-plus me-1"></i> Регистрация
                        </a>
                    }
                    @await Component.InvokeAsync("FavoritesSummary")
                    @await Component.InvokeAsync("CartSummary")
                </div>
            </div>
        </nav>
    </div>
</div>
