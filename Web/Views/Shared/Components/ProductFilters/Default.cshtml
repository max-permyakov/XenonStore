@{
    var suppliers = (ViewBag.Suppliers as List<string>) ?? new List<string>();
    var categories = (ViewBag.Categories as List<string>) ?? new List<string>();
    var priceMin = (decimal)ViewBag.PriceMin;
    var priceMax = (decimal)ViewBag.PriceMax;

    var q = Context.Request.Query;
    var sort = q["sort"].ToString();
    var minPriceVal = q["minPrice"].ToString();
    var maxPriceVal = q["maxPrice"].ToString();
    var minRatingVal = q["minRating"].ToString();
    var supplierVal = q["supplier"].ToString();
    var categoryVal = q["category"].ToString();

    var minPriceParsed = decimal.TryParse(minPriceVal, out var minParsed) ? minParsed : priceMin;
    var maxPriceParsed = decimal.TryParse(maxPriceVal, out var maxParsed) ? maxParsed : priceMax;
}

<div class="position-relative flex-shrink-0">
    <div class="d-flex align-items-center gap-2">
        <select name="sort" class="form-select form-select-sm" style="width: 160px;" onchange="this.form.submit()">
            <option value="popularity-desc" selected="@(string.IsNullOrEmpty(sort) || sort == "popularity-desc")">Популярные</option>
            <option value="price-asc" selected="@(sort == "price-asc")">Цена: по возрастанию</option>
            <option value="price-desc" selected="@(sort == "price-desc")">Цена: по убыванию</option>
            <option value="rating-desc" selected="@(sort == "rating-desc")">Рейтинг: по убыванию</option>
            <option value="rating-asc" selected="@(sort == "rating-asc")">Рейтинг: по возрастанию</option>
        </select>

        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="toggleFiltersPanel()" title="Расширенные фильтры">
            <i class="fas fa-sliders-h"></i>
        </button>
    </div>

    <div id="filters-panel" class="border rounded p-3 mt-2 bg-white d-none position-absolute start-0"
         style="width: 340px; z-index: 1050;">
        <div class="mb-3">
            <label class="form-label mb-1">Цена</label>
            <div class="d-flex gap-2 mb-2">
                <input type="number" name="minPrice" class="form-control form-control-sm" min="0" step="0.01"
                       value="@minPriceVal" placeholder="От" onchange="syncPriceSliders()" />
                <input type="number" name="maxPrice" class="form-control form-control-sm" min="0" step="0.01"
                       value="@maxPriceVal" placeholder="До" onchange="syncPriceSliders()" />
            </div>
            <input type="range" id="price-min-range" class="form-range" min="@priceMin" max="@priceMax" step="0.01"
                   value="@minPriceParsed" oninput="onPriceRangeInput('min')" />
            <input type="range" id="price-max-range" class="form-range" min="@priceMin" max="@priceMax" step="0.01"
                   value="@maxPriceParsed" oninput="onPriceRangeInput('max')" />
        </div>

        <div class="mb-3">
            <label class="form-label mb-1">Рейтинг</label>
            <select name="minRating" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="" selected="@(string.IsNullOrEmpty(minRatingVal))">Любой</option>
                <option value="3" selected="@(minRatingVal == "3")">от 3.0 ★</option>
                <option value="3.5" selected="@(minRatingVal == "3.5")">от 3.5 ★</option>
                <option value="4" selected="@(minRatingVal == "4")">от 4.0 ★</option>
                <option value="4.5" selected="@(minRatingVal == "4.5")">от 4.5 ★</option>
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label mb-1">Поставщик</label>
            <select name="supplier" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="" selected="@(string.IsNullOrEmpty(supplierVal))">Все</option>
                @foreach (var s in suppliers)
                {
                    <option value="@s" selected="@(supplierVal == s)">@s</option>
                }
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label mb-1">Категория</label>
            <select name="category" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="" selected="@(string.IsNullOrEmpty(categoryVal))">Все</option>
                @foreach (var c in categories)
                {
                    <option value="@c" selected="@(categoryVal == c)">@c</option>
                }
            </select>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary btn-sm">Применить</button>
            <a class="btn btn-outline-secondary btn-sm" href="@Url.Action("Index", "Home")">Сбросить</a>
        </div>
    </div>
</div>

<script>
    function toggleFiltersPanel() {
        document.getElementById('filters-panel').classList.toggle('d-none');
    }

    function onPriceRangeInput(side) {
        const minRange = document.getElementById('price-min-range');
        const maxRange = document.getElementById('price-max-range');
        const minInput = document.querySelector('input[name="minPrice"]');
        const maxInput = document.querySelector('input[name="maxPrice"]');

        if (side === 'min') {
            if (parseFloat(minRange.value) > parseFloat(maxRange.value)) {
                maxRange.value = minRange.value;
            }
        } else {
            if (parseFloat(maxRange.value) < parseFloat(minRange.value)) {
                minRange.value = maxRange.value;
            }
        }
        minInput.value = minRange.value;
        maxInput.value = maxRange.value;
    }

    function syncPriceSliders() {
        const minRange = document.getElementById('price-min-range');
        const maxRange = document.getElementById('price-max-range');
        const minInput = document.querySelector('input[name="minPrice"]');
        const maxInput = document.querySelector('input[name="maxPrice"]');
        const min = parseFloat(minRange.min) || 0;
        const max = parseFloat(minRange.max) || 0;

        let minVal = parseFloat(minInput.value);
        let maxVal = parseFloat(maxInput.value);
        if (isNaN(minVal)) minVal = min;
        if (isNaN(maxVal)) maxVal = max;
        if (minVal < min) minVal = min;
        if (maxVal > max) maxVal = max;
        if (minVal > maxVal) maxVal = minVal;

        minRange.value = minVal;
        maxRange.value = maxVal;
        minInput.value = minVal;
        maxInput.value = maxVal;
    }
</script>
