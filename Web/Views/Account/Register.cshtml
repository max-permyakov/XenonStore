@using Xenon.Web.Models.ViewModels.Login
@model RegisterModel
@{
    Layout = "_AuthLayout";
    ViewData["AuthTitle"] = "Xenon — Регистрация";
    ViewData["AuthSubtitle"] = "Создание аккаунта";
}

<div asp-validation-summary="All" class="text-danger mb-3"></div>

<form asp-action="Register" asp-controller="Account" method="post">
    @Html.AntiForgeryToken()

    <div class="row mb-3">
        <div class="col-md-6">
            <label asp-for="FirstName" class="form-label"></label>
            <input asp-for="FirstName" class="form-control" placeholder="Иван" autofocus />
            <span asp-validation-for="FirstName" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="LastName" class="form-label"></label>
            <input asp-for="LastName" class="form-control" placeholder="Иванов" />
            <span asp-validation-for="LastName" class="text-danger"></span>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label"></label>
        <div class="input-group">
            <span class="input-group-text"><i class="fas fa-envelope text-muted"></i></span>
            <input asp-for="Email" class="form-control" placeholder="you@example.com" />
        </div>
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Phone" class="form-label"></label>
        <div class="input-group">
            <span class="input-group-text"><i class="fas fa-phone text-muted"></i></span>
            <input asp-for="Phone" class="form-control" placeholder="+7 (999) 123-45-67" />
        </div>
        <span asp-validation-for="Phone" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Password" class="form-label"></label>
        <div class="input-group">
            <span class="input-group-text"><i class="fas fa-lock text-muted"></i></span>
            <input asp-for="Password" class="form-control" placeholder="Минимум 6 символов" />
        </div>
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ConfirmPassword" class="form-label"></label>
        <div class="input-group">
            <span class="input-group-text"><i class="fas fa-lock text-muted"></i></span>
            <input asp-for="ConfirmPassword" class="form-control" placeholder="Повторите пароль" />
        </div>
        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary w-100 mb-3">
        <i class="fas fa-user-plus me-1"></i> Зарегистрироваться
    </button>
</form>

<div class="text-center">
    <span class="text-muted">Уже есть аккаунт?</span>
    <a asp-action="Login" asp-controller="Account" class="ms-1">Войти</a>
</div>
<div class="text-center mt-2">
    <a href="/" class="text-muted small"><i class="fas fa-arrow-left me-1"></i> На главную</a>
</div>