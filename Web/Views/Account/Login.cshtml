@using Xenon.Web.Models.ViewModels.Login
@model LoginModel
@{
    Layout = "_AuthLayout";
    ViewData["AuthTitle"] = "Xenon — Вход";
    ViewData["AuthSubtitle"] = "Вход в аккаунт";
}

<div asp-validation-summary="All" class="text-danger mb-3"></div>

<form asp-action="Login" asp-controller="Account" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="ReturnUrl" />

    <div class="mb-3">
        <label asp-for="Email" class="form-label"></label>
        <div class="input-group">
            <span class="input-group-text"><i class="fas fa-envelope text-muted"></i></span>
            <input asp-for="Email" class="form-control" placeholder="you@example.com" autofocus />
        </div>
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Password" class="form-label"></label>
        <div class="input-group">
            <span class="input-group-text"><i class="fas fa-lock text-muted"></i></span>
            <input asp-for="Password" class="form-control" placeholder="Введите пароль" />
        </div>
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>

    <div class="mb-3 form-check">
        <input asp-for="RememberMe" class="form-check-input" />
        <label asp-for="RememberMe" class="form-check-label"></label>
    </div>

    <button type="submit" class="btn btn-primary w-100 mb-3">
        <i class="fas fa-sign-in-alt me-1"></i> Войти
    </button>
</form>

<div class="text-center">
    <span class="text-muted">Нет аккаунта?</span>
    <a asp-action="Register" asp-controller="Account" class="ms-1">Зарегистрироваться</a>
</div>
<div class="text-center mt-2">
    <a href="/" class="text-muted small"><i class="fas fa-arrow-left me-1"></i> На главную</a>
</div>