@{
    Layout = "_ProfileLayout";
    ViewData["Title"] = "Безопасность";
}

<h4 class="mb-4"><i class="fas fa-shield-alt me-2"></i> Безопасность</h4>

<div class="card">
    <div class="card-body">
        <h5 class="mb-3">Смена пароля</h5>
        <form asp-controller="Profile" asp-action="Security" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label class="form-label">Текущий пароль</label>
                <input name="currentPassword" type="password" class="form-control" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Новый пароль</label>
                <input name="newPassword" type="password" class="form-control" minlength="6" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Подтверждение нового пароля</label>
                <input name="confirmPassword" type="password" class="form-control" minlength="6" required />
            </div>

            <button type="submit" class="btn btn-primary"><i class="fas fa-key me-1"></i> Изменить пароль</button>
        </form>
    </div>
</div>
