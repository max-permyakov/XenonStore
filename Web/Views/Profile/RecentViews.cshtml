@using Xenon.Domain.Models
@model List<Product>
@{
    Layout = "_ProfileLayout";
    ViewData["Title"] = "Недавно просмотренные";
}

<h4 class="mb-4"><i class="fas fa-clock me-2"></i> Недавно просмотренные</h4>

@if (Model.Count > 0)
{
    <div class="row">
        @foreach (var product in Model)
        {
            <div class="col-sm-6 col-md-4 col-lg-3 mb-4">
                <div class="card h-100 shadow-sm">
                    <img src="@(string.IsNullOrEmpty(product.ImageUrl) ? "/images/placeholder.jpg" : product.ImageUrl)"
                         class="card-img-top" style="height: 160px; object-fit: cover;"
                         alt="@product.Name" />
                    <div class="card-body d-flex flex-column">
                        <p class="card-text font-weight-bold text-primary mb-1">
                            @product.Price.ToString("c")
                        </p>
                        <h6 class="card-title">@product.Name</h6>
                        @if (product.Discount > 0)
                        {
                            <span class="badge bg-danger w-auto align-self-start mb-2">-@product.Discount.Value.ToString("0.#")%</span>
                        }
                        <a href="/" class="btn btn-sm btn-primary mt-auto">
                            <i class="fas fa-cart-plus me-1"></i> В магазин
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="text-center py-5">
        <i class="fas fa-clock fa-3x text-muted mb-3"></i>
        <h5 class="text-muted">Вы ещё не просматривали товары</h5>
        <a href="/" class="btn btn-primary mt-2"><i class="fas fa-shopping-cart me-1"></i> Перейти в магазин</a>
    </div>
}