@using Xenon.Domain.Models
@model ApplicationUser
@{
    Layout = "_ProfileLayout";
    ViewData["Title"] = "Настройки";
}

<h4 class="mb-4"><i class="fas fa-cog me-2"></i> Настройки профиля</h4>

<div class="card">
    <div class="card-body">
        <form asp-controller="Profile" asp-action="Settings" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <h5 class="mb-3">Личные данные</h5>
            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label">Имя</label>
                    <input name="FirstName" class="form-control" value="@Model.FirstName" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Фамилия</label>
                    <input name="LastName" class="form-control" value="@Model.LastName" required />
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label">Email</label>
                    <input class="form-control" value="@Model.Email" readonly />
                    <small class="text-muted">Email нельзя изменить</small>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Телефон</label>
                    <input name="PhoneNumber" class="form-control" value="@Model.PhoneNumber" />
                </div>
            </div>

            <hr />
            <h5 class="mb-3">Адрес доставки</h5>
            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label">Страна</label>
                    <input name="Country" class="form-control" value="@Model.Country" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Город</label>
                    <input name="City" class="form-control" value="@Model.City" />
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-md-8">
                    <label class="form-label">Адрес (улица, дом, квартира)</label>
                    <input name="Address" class="form-control" value="@Model.Address" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Индекс</label>
                    <input name="PostalCode" class="form-control" value="@Model.PostalCode" />
                </div>
            </div>

            <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i> Сохранить</button>
        </form>
    </div>
</div>

<div class="card mt-3">
    <div class="card-body">
        <h5 class="mb-3">Фото профиля</h5>
        <div class="d-flex align-items-center gap-3">
            @if (!string.IsNullOrEmpty(Model.AvatarUrl))
            {
                <img src="@Model.AvatarUrl" class="rounded-circle" width="64" height="64" alt="avatar" />
            }
            else
            {
                <i class="fas fa-user-circle fa-3x text-muted"></i>
            }
            <form asp-controller="Profile" asp-action="UploadAvatar" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="file" name="avatar" class="form-control mb-2" accept="image/jpeg,image/png,image/webp" />
                <button type="submit" class="btn btn-outline-primary btn-sm"><i class="fas fa-upload me-1"></i> Загрузить</button>
                <small class="text-muted d-block">JPEG, PNG или WebP. Макс. 5MB.</small>
            </form>
        </div>
    </div>
</div>
