@using Xenon.Domain.Models
@model List<Order>
@{
    Layout = "_ProfileLayout";
    ViewData["Title"] = "Мои заказы";
}

<h4 class="mb-4"><i class="fas fa-shopping-bag me-2"></i> Мои заказы</h4>

@if (Model.Count > 0)
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>№</th>
                    <th>Дата</th>
                    <th>Товары</th>
                    <th>Сумма</th>
                    <th>Оплата</th>
                    <th>Доставка</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    <tr>
                        <td><strong>#@order.OrderID</strong></td>
                        <td>@order.OrderDate.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>@order.Lines.Count поз.</td>
                        <td><strong>@order.TotalAmount.ToString("N2") ₽</strong></td>
                        <td>
                            @switch (order.PaymentStatus)
                            {
                                case PaymentStatus.Paid:
                                    <span class="badge bg-success">Оплачен</span>
                                    break;
                                case PaymentStatus.Failed:
                                    <span class="badge bg-danger">Ошибка</span>
                                    break;
                                case PaymentStatus.Refunded:
                                    <span class="badge bg-info">Возврат</span>
                                    break;
                                default:
                                    <span class="badge bg-warning text-dark">Ожидает</span>
                                    break;
                            }
                        </td>
                        <td>
                            @if (order.Shipped)
                            {
                                <span class="badge bg-success">Доставлен</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">В обработке</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="text-center py-5">
        <i class="fas fa-shopping-bag fa-3x text-muted mb-3"></i>
        <h5 class="text-muted">Заказов пока нет</h5>
        <a href="/" class="btn btn-primary mt-2"><i class="fas fa-shopping-cart me-1"></i> Перейти в магазин</a>
    </div>
}
