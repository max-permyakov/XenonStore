@model IEnumerable<ProductCartViewModel>

@{
    var cartReturnUrl = ViewData["CartReturnUrl"] as string
        ?? ViewContext.HttpContext.Request.PathAndQuery();
}

@foreach (var item in Model)
{
    <div class="col-lg-3 col-md-4 col-sm-6 mb-4" id="card-@item.Product.ProductID">
        <div class="card h-100 shadow-sm">
             <img src="@(string.IsNullOrEmpty(item.Product.ImageUrl) ? "/images/placeholder.jpg" : item.Product.ImageUrl)"
         class="card-img-top product-card-img"
         alt="@item.Product.Name" />
            <div class="card-body d-flex flex-column">
                <p class="card-text font-weight-bold text-primary mb-1">
                    @item.Product.Price.ToString("c")
                </p>
                <h5 class="card-title product-card-title">@item.Product.Name</h5>
                <p class="card-text text-muted small product-card-description">@item.Product.Description</p>

                <div class="mt-auto quantity-control d-flex align-items-center mb-2 justify-content-center pt-2">
                    @if (item.QuantityInCart > 0)
                    {
                        <button class="btn btn-outline-secondary btn-sm btn-cart-action"
                                data-product-id="@item.Product.ProductID"
                                data-action="remove">
                            −
                        </button>
                        <span class="mx-2 badge badge-pill badge-primary text-dark quantity-badge"
                              data-product-id="@item.Product.ProductID"
                              style="min-width:2rem;">
                            @item.QuantityInCart
                        </span>
                        <button class="btn btn-outline-success btn-sm btn-cart-action"
                                data-product-id="@item.Product.ProductID"
                                data-action="add">
                            +
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-primary btn-sm btn-cart-action"
                                data-product-id="@item.Product.ProductID"
                                data-action="add">
                            <i class="fas fa-cart-plus"></i> Add
                        </button>
                    }
                </div>

                @if (item.QuantityInCart > 0)
                {
                    <a class="btn btn-sm bg-gradient d-inline" asp-page="/Cart"
                       asp-route-returnurl="@($"{cartReturnUrl}#card-{item.Product.ProductID}")">
                        <i class="fa fa-shopping-cart"></i> В корзину
                    </a>
                }
            </div>
        </div>
    </div>
}