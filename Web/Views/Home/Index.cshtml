@using Microsoft.AspNetCore.Antiforgery
@model ProductsListWithCartViewModel

@{
    ViewBag.Title = "Xenon";
}
@inject IAntiforgery Antiforgery
@{
    var antiforgeryToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;
}
<div class="container my-4">
    <div class="row mb-4">
        <div class="col-12">
            <form method="get" asp-action="Index" id="filterForm">
                <div class="d-flex flex-wrap align-items-start gap-2">
                    @await Component.InvokeAsync("ProductFilters")
                    <div class="d-flex flex-grow-1" style="min-width: 260px;">
                        <input type="text"
                               name="searchTerm"
                               class="form-control me-2"
                               placeholder="Search products..."
                               value="@Model?.SearchTerm" />
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-search"></i> Search
                        </button>
                        @if (!string.IsNullOrEmpty(Model?.SearchTerm?.ToString()))
                        {
                            <a asp-action="Index" class="btn btn-outline-secondary ms-2">Clear</a>
                        }
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="row" id="product-list">
        @if (Model?.Products != null && Model.Products.Any())
        {
            @await Html.PartialAsync("_ProductGridItems", Model.Products)
        }
        else
        {
            <div class="col-12 text-center py-5">
                <h4>No products found</h4>
                <p class="text-muted">Try adjusting your search or filters</p>
            </div>
        }
    </div>

    <div id="scroll-trigger" style="height: 1px;"></div>

    <div id="loading-spinner" class="text-center my-3" style="display:none;">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const token = '@antiforgeryToken';
        let currentPage = @(Model?.PagingInfo?.CurrentPage ?? 1);
        const pageSize = @(Model?.PagingInfo?.ItemsPerPage ?? 20);
        let category = '@(Model?.CurrentCategory ?? "")' || null;
        let searchTerm = '@(Model?.SearchTerm ?? "")' || null; 
        let isLoading = false;
        let hasMore = @(Model?.PagingInfo != null && Model.PagingInfo.CurrentPage < Model.PagingInfo.TotalPages ? "true" : "false");
        const trigger = document.getElementById('scroll-trigger');
        const productList = document.getElementById('product-list');
        const spinner = document.getElementById('loading-spinner');

        const observer = new IntersectionObserver((entries) => {
            if (entries[0].isIntersecting && hasMore && !isLoading) {
                loadMore();
            }
        }, {
            rootMargin: '0px 0px 100px 0px'
        });

        if (hasMore) {
            observer.observe(trigger);
        }

        function loadMore() {
            isLoading = true;
            spinner.style.display = 'block';
            const nextPage = currentPage + 1;
            const params = new URLSearchParams(window.location.search);
            if (category) {
                params.set('category', category);
            }
            if (searchTerm) {
                params.set('searchTerm', searchTerm);
            }
            params.set('page', nextPage);

            fetch(`/Home/LoadMore?${params.toString()}`)
                .then(response => response.text())
                .then(html => {
                    const tempDiv = document.createElement('div');
                    tempDiv.innerHTML = html;

                    const items = tempDiv.querySelectorAll('.col-lg-3');
                    if (items.length) {
                        items.forEach(el => productList.appendChild(el));
                    } else {
                        hasMore = false;
                    }
                    if (items.length < pageSize) {
                        hasMore = false;
                    }

                    currentPage = nextPage;
                    isLoading = false;
                    spinner.style.display = 'none';

                    if (hasMore) {
                        observer.unobserve(trigger);
                        observer.observe(trigger);
                    } else {
                        observer.disconnect();
                    }
                })
                .catch(error => {
                    console.error('Error loading more products:', error);
                    isLoading = false;
                    spinner.style.display = 'none';
                });
        }
        document.addEventListener('click', function(e) {
            const btn = e.target.closest('.btn-cart-action');
            if (!btn) return;

            e.preventDefault();
            const productId = btn.dataset.productId;
            const action = btn.dataset.action;
            const url = `/Cart?handler=${action === 'add' ? 'AddOne' : 'RemoveOne'}`;

            // Показываем индикатор загрузки (опционально)
            btn.disabled = true;
            btn.innerHTML = '...';

            fetch(url, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token,
                    'X-CSRF-TOKEN': token,
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: new URLSearchParams({
                    productId: productId,
                    returnUrl: window.location.pathname + window.location.search
                })
            })
                .then(response => {
                    if (!response.ok) throw new Error('Network error');
                    return response.json(); // ожидаем JSON с новым количеством
                })
                .then(data => {
                    // Обновляем количество в карточке
                    const badge = document.querySelector(`.quantity-badge[data-product-id="${productId}"]`);
                    if (badge) {
                        if (data.quantity > 0) {
                            badge.textContent = data.quantity;
                        } else {
                            // Если количество стало 0, перерисовываем кнопки
                            // проще всего перезагрузить карточку или скрыть
                            location.reload(); // временное решение, но лучше обновить DOM
                        }
                    } else {
                        // Если кнопки не было (была только Add), обновляем весь блок
                        // Можно перезагрузить карточку через PartialView
                        refreshProductCard(productId);
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('Failed to update cart');
                })
                .finally(() => {
                    btn.disabled = false;
                    btn.innerHTML = btn.dataset.action === 'add' ? '+' : '−';
                });
        });

        // Функция для обновления карточки через PartialView
        function refreshProductCard(productId) {
            const returnUrl = window.location.pathname + window.location.search;
            fetch(`/Home/ProductCard?productId=${productId}&returnUrl=${encodeURIComponent(returnUrl)}`)
                .then(response => response.text())
                .then(html => {
                    const container = document.querySelector(`[data-product-id="${productId}"]`)?.closest('.col-lg-3');
                    if (container) {
                        const temp = document.createElement('div');
                        temp.innerHTML = html;
                        const newCard = temp.querySelector('.col-lg-3');
                        container.replaceWith(newCard);
                    }
                });
        }
    </script>
}